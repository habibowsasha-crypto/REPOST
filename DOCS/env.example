# --- Telegram ---
# https://my.telegram.org
API_ID=12345678
API_HASH=your_api_hash_here

# @BotFather bot token
BOT_TOKEN=123456:ABC-DEF

# Comma-separated Telegram user ids allowed to control the bot
ADMIN_ID_LIST=123456789

# --- Paths (Railway Volume) ---
# Mount a volume at /data and keep these defaults, or override.
DB_PATH=/data/bot.db
BOT_SESSION_PATH=/data/bot
MEDIA_DIR=/data/media

# --- Channel promo ---
CHANNEL_LINK=https://t.me/+your_invite_hash
CHANNEL_PITCH=Бесплатный канал: софт почти сразу копирует новые посты из закрытых VIP-каналов, отдельные доступы покупать не нужно

# --- OpenAI (Step 8+) ---
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT_SECONDS=20
AI_DM_ENABLED=true

# --- Pacing defaults (seconds) ---
# Per-account pause between first DMs: 2-7 min
DM_ACCOUNT_INTERVAL_MIN=120
DM_ACCOUNT_INTERVAL_MAX=420
# Global pause between any first DMs: 90-180 sec
DM_GLOBAL_SPACING_MIN=90
DM_GLOBAL_SPACING_MAX=180
# Daily first-DM cap per account
DM_DAILY_LIMIT_PER_ACCOUNT=125
# AI reply delay after user message
AI_REPLY_DELAY_MIN=20
AI_REPLY_DELAY_MAX=60
# Smoothing apology if user stays silent after promo
AI_APOLOGY_DELAY_MIN=60
AI_APOLOGY_DELAY_MAX=60
# Ordinary PeerFlood cooldown range
PEER_FLOOD_COOLDOWN_MIN_SECONDS=60
PEER_FLOOD_COOLDOWN_MAX_SECONDS=90
# Legacy key is read only when the second-based range is absent
PEER_FLOOD_MIN_COOLDOWN_MINUTES=1
SPAMBOT_AUTO_RESUME=true
FLOODWAIT_EXTRA_SECONDS=45

# --- Dialog retention ---
# Recommended mode: delete the Telegram dialog after 7 full days without any
# incoming or outgoing message. New activity restarts the timer.
DIALOG_AUTO_DELETE_ENABLED=true
DIALOG_AUTO_DELETE_AFTER_DAYS=7
DIALOG_AUTO_DELETE_FOR_BOTH=true
# Legacy rollback mode used only when DIALOG_AUTO_DELETE_ENABLED=false.
TELEGRAM_DIALOG_DELETE_DAYS=30
# Purge only message texts from SQLite; metadata/statistics stay.
LOCAL_DIALOG_TEXT_RETENTION_DAYS=180

# Optional log level: DEBUG, INFO, WARNING
LOG_LEVEL=INFO

# First DM mode: magnet, short_hook or legacy
# short_hook uses reviewed short hooks; help always refers to a question
FIRST_DM_STYLE=magnet

# Post-reply dialog flow: 1, 2 or 3
# Variant 3 puts the approved short opening hint directly under the promo link
# and sends detailed link help only after a real user problem.
DIALOG_FLOW_VARIANT=1
